print("== Generador de pirámide==")
while True:
    size = input("Height: ")
    print(f"Pirámide de altura {size} generada con éxito")

    try:
        if int(size) >= 1 and int(size) <= 8:
            row = ""
            column = ""
            for i in range(int(size)):
                row += "#"
                column = " " * ((int(size) - 1) - i)
                print(column + row)
            break

        else:
            print("Enter a number between 1 and 8")

    except ValueError:
        print("Enter a valid Integer between 1 and 8")
